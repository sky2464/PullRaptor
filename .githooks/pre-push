#!/usr/bin/env bash
set -euo pipefail

# Check pushes to prevent direct push to main
while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        echo "ERROR: Direct pushes to 'main' are prohibited." >&2
        echo "All changes must be submitted via pull request branches." >&2
        exit 1
    fi
done

exit 0
